# Copy to .env and fill in. Never commit .env.

# Local SQLite (default) or Supabase Postgres:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=sqlite:///./reelm.db

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional: pin "today" (YYYY-MM-DD) for release-date logic
CATALOG_TODAY=

# Admin panel (/admin). It stays OFF until ADMIN_PASSWORD is set.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=   (at least 12 characters)
# Random string that signs the login cookie (stay logged in across restarts)
# ADMIN_SECRET_KEY=
# true in production (HTTPS)
ADMIN_COOKIE_SECURE=false

# Supabase Storage for images (Project Settings > API keys). The secret / service_role
# key has full access to the project: backend only, never in reelm-fe.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
